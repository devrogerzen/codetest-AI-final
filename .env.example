# Copiá este archivo como .env y completá tu key (el .env NO se sube a GitHub).
# Con docker-compose, las URLs de Redis, Chroma y Phoenix las pone el compose: no hace falta tocarlas.

# --- Modo sin key: modelos simulados y embeddings locales (para probar todo sin costo) ---
SIN_API=0

# --- LLM: google | openai | anthropic ---
# Gemini tiene plan gratis (key en https://aistudio.google.com/apikey): es la configuración de las corridas del README
LLM_PROVIDER=google
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.1-flash-lite
SUPERVISOR_MODEL=gemini-3.5-flash-lite
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-4-5

# Límites del proveedor: tope de llamadas por minuto a cada modelo (0 = sin tope) y reintentos ante 429/5xx.
# El plan gratis de Gemini corta en 15 por minuto y por modelo.
LLM_RPM=14
LLM_MAX_RETRIES=10

# --- Embeddings y RAG ---
# local (sin key) | google | openai. Por defecto, el mismo proveedor del LLM (anthropic no tiene embeddings).
EMBEDDINGS_PROVIDER=google
EMBEDDINGS_MODEL=gemini-embedding-001
# el plan gratis de Gemini cuenta 100 textos por minuto
EMBEDDINGS_RPM=90
# CHROMA_COLLECTION=colibri-conocimiento
CHUNK_TOKENS=400
OVERLAP_TOKENS=40
TOP_K=4
# peso de BM25 en la fusión RRF (los vectores pesan 1 - PESO_BM25)
PESO_BM25=0.5

# --- Infraestructura (para correr la API fuera de Docker; el compose las pisa con las de la red interna) ---
REDIS_URL=redis://localhost:6379
# con el Chroma del compose (puerto 8001); sin esto usa la carpeta ./chroma_db
# CHROMA_HOST=localhost
# CHROMA_PORT=8001
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT_NAME=colibri-intelligence
TRAZAS=1

# Workers dentro del proceso de la API. Con 0, los workers corren aparte: python -m app.worker
WORKERS=3

# --- Orquestador ---
# pesos: una acción más cara espera la aprobación de una persona
UMBRAL_APROBACION=50000
MAX_DELEGACIONES=8

# --- Seguridad (opcional): si se define, la API exige el header X-API-Key ---
# API_KEY=
