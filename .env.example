# Copiá este archivo como .env y completá tu key (el .env NO se sube a GitHub)

# Infraestructura (los valores de docker-compose.yml en local)
REDIS_URL=redis://localhost:6379
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT_NAME=colibri-orquestador
TRAZAS=1

# Workers dentro del proceso de la API. Con 0, los workers corren aparte: python -m app.worker
WORKERS=3

# Human-in-the-loop: una acción con costo estimado mayor a esto (pesos) necesita aprobación humana
UMBRAL_APROBACION=50000
MAX_DELEGACIONES=8

# LLM: openai | anthropic | google. Con SIN_API=1 usa los modelos simulados (sin key, sin costo)
SIN_API=0
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# SUPERVISOR_MODEL=gpt-4o
# OPENAI_BASE_URL=
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5

# Gemini gratis (key en https://aistudio.google.com/apikey). Es la configuración de la corrida del README:
# LLM_PROVIDER=google
# GOOGLE_API_KEY=...
# GOOGLE_MODEL=gemini-3.1-flash-lite
# SUPERVISOR_MODEL=gemini-3.5-flash-lite

# Límites del proveedor: tope de llamadas por minuto a cada modelo (0 = sin tope) y reintentos ante 429/5xx.
# El plan gratis de Gemini corta en 15 por minuto y por modelo: LLM_RPM=14 y LLM_MAX_RETRIES=10.
LLM_RPM=0
LLM_MAX_RETRIES=2
